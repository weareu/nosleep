{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    // rootDir is the repo root, not ./src: the server imports mcp-gateway src
    // in-process (the HTTP MCP endpoint) and runs via tsx (not dist), so a ./src
    // rootDir would TS6059 on that intentional cross-package import.
    "rootDir": "../.."
  },
  "include": ["src"]
}
