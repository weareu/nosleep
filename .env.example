# NoSleep Server Configuration
PORT=3777
DB_PATH=./data/nosleep.db

# Authentication (generate with: openssl rand -hex 32)
NOSLEEP_API_KEY=
NOSLEEP_HOOK_SECRET=

# Only needed for API-type accounts (Pro/Max use CLI auth)
# ANTHROPIC_API_KEY=sk-ant-...

# Gemini API Key (optional - NotebookLM uses browser auth instead)
# GEMINI_API_KEY=

# Background LLM routing (see docs/deployment.md "Local / alternative models").
# Default: everything on Claude (your subscription). Per-purpose overrides:
# append _BRAIN, _VALIDATOR, _RESPONDER or _VISION to any key below.
# NOSLEEP_LLM_PROVIDER=claude            # claude | openai (OpenAI-compatible endpoint)
# NOSLEEP_LLM_BASE_URL=http://localhost:11434/v1   # Ollama; LM Studio :1234/v1; OpenRouter https://openrouter.ai/api/v1
# NOSLEEP_LLM_MODEL=
# NOSLEEP_LLM_API_KEY=                   # only for hosted endpoints
# NOSLEEP_LLM_TIMEOUT_MS=                # overrides the caller's timeout on the openai route
# NOSLEEP_LLM_FALLBACK=none              # none | claude (retry failed openai calls on Claude)
# NOSLEEP_LLM_MODEL_VISION=              # vision only routes to openai when this is set
#
# Example: memory/brain work on local Ollama, validator + responder stay on Claude
# NOSLEEP_LLM_PROVIDER_BRAIN=openai
# NOSLEEP_LLM_MODEL_BRAIN=qwen2.5:7b-instruct
